{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>/tests"],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "tsconfig.test.json" }]
  },
  "collectCoverageFrom": ["src/**/*.ts", "!src/index.ts"],
  "coverageDirectory": "coverage"
}
